## **Step 9: Render Page (getViewport)**

```javascript
function getViewport(page) {
    const originalViewport = page.getViewport({ scale: 1 });
    // originalViewport.width = 612 (PDF default)
    
    const maxWidth = Math.min(window.innerWidth - 40, 1000);
    // maxWidth = 960 (assuming window width = 1000)
    
    let scale = maxWidth / originalViewport.width;
    // scale = 960 / 612 = 1.57
    
    scale = Math.min(scale, 1.5);  // Cap at 1.5
    // scale = 1.5
    
    scale = Math.max(scale, 0.5);  // Floor at 0.5
    // scale = 1.5 (unchanged)
    
    return page.getViewport({ scale: 1.5 });
}
```

**Output:**
```javascript
{
  width: 918,      // 612 × 1.5
  height: 1188,    // 792 × 1.5
  scale: 1.5,
  rotation: 0
}
```

