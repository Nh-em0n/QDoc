import * as pdfjsLib from
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/5.4.149/pdf.min.mjs";


/*
 * PDF.js worker
 */
pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/5.4.149/pdf.worker.min.mjs";


/*
 * DOM elements
 */
const pdfInput = document.getElementById("pdfInput");
const clearBtn = document.getElementById("clearBtn");

const pdfContainer =
    document.getElementById("pdfContainer");

const loading =
    document.getElementById("loading");

const error =
    document.getElementById("error");

const pdfInfo =
    document.getElementById("pdfInfo");

const pdfName =
    document.getElementById("pdfName");

const pageCount =
    document.getElementById("pageCount");

const fileInfo =
    document.getElementById("fileInfo");


/*
 * Current PDF
 */
let currentPDF = null;


/*
 * IntersectionObserver
 */
let pageObserver = null;


/*
 * PDF file selection
 */
pdfInput.addEventListener("change", async function () {

    const file = this.files[0];

    if (!file) {
        return;
    }


    /*
     * Validate PDF
     */
    if (
        file.type !== "application/pdf" &amp;&amp;
        !file.name.toLowerCase().endsWith(".pdf")
    ) {

        showError(
            "Please select a valid PDF file."
        );

        return;
    }


    try {

        /*
         * Reset viewer
         */
        clearViewer();

        showError("");

        error.classList.add("d-none");

        showLoading(true);


        /*
         * File information
         */
        fileInfo.textContent =
            `Selected: ${file.name}`;


        /*
         * Read file
         */
        const arrayBuffer =
            await file.arrayBuffer();
        if(arrayBuffer){
            print(arrayBuffer)
        }

        /*
         * Load PDF
         */
        const loadingTask =
            pdfjsLib.getDocument({
                data: arrayBuffer
            });
        print(loadingTask) 

        currentPDF =
            await loadingTask.promise;

        print(currentPDF)

        /*
         * PDF information
         */
        pdfName.textContent =
            file.name;

        pageCount.textContent =
            currentPDF.numPages;

        pdfInfo.classList.remove(
            "d-none"
        );


        /*
         * Create page placeholders
         */
        await createPagePlaceholders(
            currentPDF
        );


        /*
         * Start lazy rendering
         */
        setupPageObserver();


    } catch (err) {

        console.error(err);

        showError(
            "Unable to load this PDF. " +
            "The file may be corrupted or unsupported."
        );

    } finally {

        showLoading(false);

    }

});


/*
 * Create placeholders for all pages
 */
async function createPagePlaceholders(pdf) {

    pdfContainer.innerHTML = "";


    /*
     * Create one element for every page
     */
    for (
        let pageNumber = 1;
        pageNumber &lt;= pdf.numPages;
        pageNumber++
    ) {

        const pageElement =
            document.createElement("div");


        pageElement.className =
            "pdf-page";


        /*
         * Store page number
         */
        pageElement.dataset.page =
            pageNumber;


        /*
         * Wrapper
         */
        const wrapper =
            document.createElement("div");


        wrapper.className =
            "pdf-page-wrapper";


        /*
         * Page number
         */
        const pageNumberElement =
            document.createElement("div");


        pageNumberElement.className =
            "page-number";


        pageNumberElement.textContent =
            `Page ${pageNumber}`;


        /*
         * Loading message
         */
        const placeholder =
            document.createElement("div");


        placeholder.className =
            "pdf-placeholder";


        placeholder.innerHTML = `
            <div class="spinner-border spinner-border-sm" role="status"></div>

            <span class="ms-2">
                Loading page ${pageNumber}...
            </span>
        `;


        /*
         * Add elements
         */
        wrapper.appendChild(
            placeholder
        );

        wrapper.appendChild(
            pageNumberElement
        );

        pageElement.appendChild(
            wrapper
        );


        pdfContainer.appendChild(
            pageElement
        );


        /*
         * Yield to browser
         *
         * This prevents the browser from
         * getting one long-running loop.
         */
        if (pageNumber % 10 === 0) {

            await new Promise(
                resolve =&gt; setTimeout(
                    resolve,
                    0
                )
            );

        }

    }

}


/*
 * Setup IntersectionObserver
 */
function setupPageObserver() {

    /*
     * Remove previous observer
     */
    if (pageObserver) {

        pageObserver.disconnect();

    }


    /*
     * Create observer
     */
    pageObserver =
        new IntersectionObserver(
            function (entries) {

                for (const entry of entries) {

                    if (!entry.isIntersecting) {
                        continue;
                    }


                    const pageElement =
                        entry.target;


                    /*
                     * Stop observing after
                     * the page has been rendered.
                     */
                    pageObserver.unobserve(
                        pageElement
                    );


                    /*
                     * Get page number
                     */
                    const pageNumber =
                        Number(
                            pageElement.dataset.page
                        );


                    /*
                     * Render page
                     */
                    renderPage(
                        currentPDF,
                        pageNumber,
                        pageElement
                    );

                }

            },
            {

                /*
                 * Start rendering pages
                 * before they enter viewport.
                 */
                rootMargin: "800px 0px"

            }
        );


    /*
     * Observe all page elements
     */
    const pages =
        document.querySelectorAll(
            ".pdf-page"
        );


    pages.forEach(page =&gt; {

        pageObserver.observe(page);

    });

}


/*
 * Render one PDF page
 */
async function renderPage(
    pdf,
    pageNumber,
    pageElement
) {

    try {

        /*
         * Get page
         */
        const page =
            await pdf.getPage(
                pageNumber
            );


        /*
         * Get viewport
         */
        const viewport =
            getViewport(
                page
            );


        /*
         * Find wrapper
         */
        const wrapper =
            pageElement.querySelector(
                ".pdf-page-wrapper"
            );


        /*
         * Remove placeholder
         */
        const placeholder =
            wrapper.querySelector(
                ".pdf-placeholder"
            );


        if (placeholder) {

            placeholder.remove();

        }


        /*
         * Create canvas
         */
        const canvas =
            document.createElement(
                "canvas"
            );


        const context =
            canvas.getContext(
                "2d"
            );


        /*
         * Canvas dimensions
         */
        canvas.width =
            Math.floor(
                viewport.width
            );

        canvas.height =
            Math.floor(
                viewport.height
            );


        /*
         * Add canvas
         */
        wrapper.prepend(
            canvas
        );


        /*
         * Render PDF page
         */
        await page.render({

            canvasContext:
                context,

            viewport:
                viewport

        }).promise;


    } catch (err) {

        console.error(
            `Error rendering page ${pageNumber}:`,
            err
        );


        /*
         * Show page error
         */
        const wrapper =
            pageElement.querySelector(
                ".pdf-page-wrapper"
            );


        wrapper.innerHTML = `
            <div class="p-5 text-center text-danger">
                Unable to render page ${pageNumber}
            </div>
        `;

    }

}


/*
 * Calculate viewport
 */
function getViewport(page) {

    const originalViewport =
        page.getViewport({
            scale: 1
        });


    /*
     * Maximum viewer width
     */
    const maxWidth =
        Math.min(
            window.innerWidth - 40,
            1000
        );


    /*
     * Calculate scale
     */
    let scale =
        maxWidth /
        originalViewport.width;


    /*
     * Do not make PDF too large
     */
    scale =
        Math.min(
            scale,
            1.5
        );


    /*
     * Prevent extremely small pages
     */
    scale =
        Math.max(
            scale,
            0.5
        );


    return page.getViewport({
        scale: scale
    });

}


/*
 * Clear button
 */
clearBtn.addEventListener(
    "click",
    function () {

        pdfInput.value = "";

        clearViewer();

        fileInfo.textContent =
            "Select a PDF file from your computer.";

    }
);


/*
 * Clear viewer
 */
function clearViewer() {

    /*
     * Stop observing pages
     */
    if (pageObserver) {

        pageObserver.disconnect();

        pageObserver = null;

    }


    /*
     * Remove PDF
     */
    currentPDF = null;


    /*
     * Remove pages
     */
    pdfContainer.innerHTML = "";


    /*
     * Hide information
     */
    pdfInfo.classList.add(
        "d-none"
    );


    /*
     * Hide error
     */
    error.classList.add(
        "d-none"
    );

}


/*
 * Loading indicator
 */
function showLoading(show) {

    if (show) {

        loading.classList.remove(
            "d-none"
        );

    } else {

        loading.classList.add(
            "d-none"
        );

    }

}


/*
 * Error message
 */
function showError(message) {

    error.textContent =
        message;

    if (message) {

        error.classList.remove(
            "d-none"
        );

    }

}


```


